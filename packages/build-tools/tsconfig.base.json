{
    "compilerOptions": {
        "target": "es2023",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": [
            "es2023"
        ],
        "sourceMap": true,
        "importHelpers": false,
        "strict": true,
        "declaration": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true
    }
}
